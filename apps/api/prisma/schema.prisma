generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum StockMovementType {
  RECEIPT
  RESERVATION
  RELEASE
  SALE_DISPATCH
  TRANSFER_OUT
  TRANSFER_IN
  CUSTOMER_RETURN
  ADJUSTMENT
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum TransferStatus {
  DRAFT
  DISPATCHED
  RECEIVED
  CANCELLED
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String       @map("password_hash")
  displayName  String       @map("display_name")
  status       UserStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles        UserRole[]
  warehouses   UserWarehouse[]
  auditEvents  AuditEvent[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  roleLinks   RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Warehouse {
  id        String          @id @default(uuid()) @db.Uuid
  code      String          @unique
  name      String
  address   String?
  active    Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  userScope UserWarehouse[]
  balances  InventoryBalance[]
  movements StockMovement[]
  reservations StockReservation[]
  sourceTransfers WarehouseTransfer[] @relation("transfer_source")
  destinationTransfers WarehouseTransfer[] @relation("transfer_destination")

  @@map("warehouses")
}

model UserWarehouse {
  userId      String    @map("user_id") @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  isDefault   Boolean   @default(false) @map("is_default")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
  @@map("user_warehouses")
}

model Category {
  id       String     @id @default(uuid()) @db.Uuid
  name     String
  parentId String?    @map("parent_id") @db.Uuid
  active   Boolean    @default(true)
  parent   Category?  @relation("category_tree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("category_tree")
  products Product[]

  @@unique([name, parentId])
  @@map("categories")
}

model Product {
  id            String    @id @default(uuid()) @db.Uuid
  sku           String    @unique
  name          String
  description   String?
  categoryId    String?   @map("category_id") @db.Uuid
  baseUnit      String    @default("each") @map("base_unit")
  barcode       String?   @unique
  reorderPoint  Int?      @map("reorder_point")
  reorderQty    Int?      @map("reorder_qty")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  balances      InventoryBalance[]
  movements     StockMovement[]
  reservations  StockReservation[]
  transferLines WarehouseTransferLine[]

  @@map("products")
}

model InventoryBalance {
  productId   String    @map("product_id") @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  onHand      Int       @default(0) @map("on_hand")
  reserved    Int       @default(0)
  version     Int       @default(0)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@id([productId, warehouseId])
  @@map("inventory_balances")
}

model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  movementGroupId String            @map("movement_group_id") @db.Uuid
  productId       String            @map("product_id") @db.Uuid
  warehouseId     String            @map("warehouse_id") @db.Uuid
  quantity        Int
  movementType    StockMovementType @map("movement_type")
  referenceType   String?           @map("reference_type")
  referenceId     String?           @map("reference_id")
  reason          String?
  actorId         String?           @map("actor_id") @db.Uuid
  occurredAt      DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(6)
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse       Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([productId, warehouseId, occurredAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model StockReservation {
  id          String            @id @default(uuid()) @db.Uuid
  productId   String            @map("product_id") @db.Uuid
  warehouseId String            @map("warehouse_id") @db.Uuid
  referenceId String            @map("reference_id")
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime?         @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([referenceId, status])
  @@index([productId, warehouseId, status])
  @@map("stock_reservations")
}

model WarehouseTransfer {
  id                     String                 @id @default(uuid()) @db.Uuid
  number                 String                 @unique
  sourceWarehouseId      String                 @map("source_warehouse_id") @db.Uuid
  destinationWarehouseId String                 @map("destination_warehouse_id") @db.Uuid
  status                 TransferStatus         @default(DRAFT)
  requestedAt            DateTime               @default(now()) @map("requested_at") @db.Timestamptz(6)
  dispatchedAt           DateTime?              @map("dispatched_at") @db.Timestamptz(6)
  receivedAt             DateTime?              @map("received_at") @db.Timestamptz(6)
  createdById            String                 @map("created_by_id") @db.Uuid
  sourceWarehouse        Warehouse              @relation("transfer_source", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse   Warehouse              @relation("transfer_destination", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  lines                  WarehouseTransferLine[]

  @@index([sourceWarehouseId, status])
  @@index([destinationWarehouseId, status])
  @@map("warehouse_transfers")
}

model WarehouseTransferLine {
  id            String            @id @default(uuid()) @db.Uuid
  transferId    String            @map("transfer_id") @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  requestedQty  Int               @map("requested_qty")
  dispatchedQty Int               @default(0) @map("dispatched_qty")
  receivedQty   Int               @default(0) @map("received_qty")
  transfer      WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([transferId, productId])
  @@map("warehouse_transfer_lines")
}

model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  contactName   String?  @map("contact_name")
  email         String?
  phone         String?
  address       String?
  paymentTerms  String?  @map("payment_terms")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("suppliers")
}

model Customer {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  contactName   String?  @map("contact_name")
  email         String?
  phone         String?
  address       String?
  paymentTerms  String?  @map("payment_terms")
  creditLimit   Decimal? @map("credit_limit") @db.Decimal(18, 2)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("customers")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  requestId  String?  @map("request_id")
  reason     String?
  before     Json?
  after      Json?
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, occurredAt])
  @@map("audit_events")
}

