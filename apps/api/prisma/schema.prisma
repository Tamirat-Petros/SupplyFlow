generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum StockMovementType {
  RECEIPT
  RESERVATION
  RELEASE
  SALE_DISPATCH
  TRANSFER_OUT
  TRANSFER_IN
  CUSTOMER_RETURN
  ADJUSTMENT
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum TransferStatus {
  DRAFT
  DISPATCHED
  RECEIVED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ReceiptStatus {
  POSTED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum ShipmentStatus {
  DISPATCHED
  DELIVERED
  FAILED
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String       @map("password_hash")
  displayName  String       @map("display_name")
  status       UserStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles        UserRole[]
  warehouses   UserWarehouse[]
  auditEvents  AuditEvent[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  roleLinks   RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Warehouse {
  id        String          @id @default(uuid()) @db.Uuid
  code      String          @unique
  name      String
  address   String?
  active    Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  userScope UserWarehouse[]
  balances  InventoryBalance[]
  movements StockMovement[]
  reservations StockReservation[]
  sourceTransfers WarehouseTransfer[] @relation("transfer_source")
  destinationTransfers WarehouseTransfer[] @relation("transfer_destination")
  purchaseOrders PurchaseOrder[]
  salesOrders SalesOrder[]
  shipments Shipment[]

  @@map("warehouses")
}

model UserWarehouse {
  userId      String    @map("user_id") @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  isDefault   Boolean   @default(false) @map("is_default")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
  @@map("user_warehouses")
}

model Category {
  id       String     @id @default(uuid()) @db.Uuid
  name     String
  parentId String?    @map("parent_id") @db.Uuid
  active   Boolean    @default(true)
  parent   Category?  @relation("category_tree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("category_tree")
  products Product[]

  @@unique([name, parentId])
  @@map("categories")
}

model Product {
  id            String    @id @default(uuid()) @db.Uuid
  sku           String    @unique
  name          String
  description   String?
  categoryId    String?   @map("category_id") @db.Uuid
  baseUnit      String    @default("each") @map("base_unit")
  barcode       String?   @unique
  reorderPoint  Int?      @map("reorder_point")
  reorderQty    Int?      @map("reorder_qty")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  balances      InventoryBalance[]
  movements     StockMovement[]
  reservations  StockReservation[]
  transferLines WarehouseTransferLine[]
  purchaseOrderLines PurchaseOrderLine[]
  receiptLines PurchaseReceiptLine[]
  salesOrderLines SalesOrderLine[]
  shipmentLines ShipmentLine[]

  @@map("products")
}

model InventoryBalance {
  productId   String    @map("product_id") @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  onHand      Int       @default(0) @map("on_hand")
  reserved    Int       @default(0)
  version     Int       @default(0)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@id([productId, warehouseId])
  @@map("inventory_balances")
}

model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  movementGroupId String            @map("movement_group_id") @db.Uuid
  productId       String            @map("product_id") @db.Uuid
  warehouseId     String            @map("warehouse_id") @db.Uuid
  quantity        Int
  movementType    StockMovementType @map("movement_type")
  referenceType   String?           @map("reference_type")
  referenceId     String?           @map("reference_id")
  reason          String?
  actorId         String?           @map("actor_id") @db.Uuid
  occurredAt      DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(6)
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse       Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([productId, warehouseId, occurredAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model StockReservation {
  id          String            @id @default(uuid()) @db.Uuid
  productId   String            @map("product_id") @db.Uuid
  warehouseId String            @map("warehouse_id") @db.Uuid
  referenceId String            @map("reference_id")
  quantity    Int
  remainingQty Int              @map("remaining_qty")
  remainingQty Int              @map("remaining_qty")
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime?         @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([referenceId, status])
  @@index([productId, warehouseId, status])
  @@map("stock_reservations")
}

model WarehouseTransfer {
  id                     String                 @id @default(uuid()) @db.Uuid
  number                 String                 @unique
  sourceWarehouseId      String                 @map("source_warehouse_id") @db.Uuid
  destinationWarehouseId String                 @map("destination_warehouse_id") @db.Uuid
  status                 TransferStatus         @default(DRAFT)
  requestedAt            DateTime               @default(now()) @map("requested_at") @db.Timestamptz(6)
  dispatchedAt           DateTime?              @map("dispatched_at") @db.Timestamptz(6)
  receivedAt             DateTime?              @map("received_at") @db.Timestamptz(6)
  createdById            String                 @map("created_by_id") @db.Uuid
  sourceWarehouse        Warehouse              @relation("transfer_source", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse   Warehouse              @relation("transfer_destination", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  lines                  WarehouseTransferLine[]

  @@index([sourceWarehouseId, status])
  @@index([destinationWarehouseId, status])
  @@map("warehouse_transfers")
}

model WarehouseTransferLine {
  id            String            @id @default(uuid()) @db.Uuid
  transferId    String            @map("transfer_id") @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  requestedQty  Int               @map("requested_qty")
  dispatchedQty Int               @default(0) @map("dispatched_qty")
  receivedQty   Int               @default(0) @map("received_qty")
  transfer      WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([transferId, productId])
  @@map("warehouse_transfer_lines")
}

model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  contactName   String?  @map("contact_name")
  email         String?
  phone         String?
  address       String?
  paymentTerms  String?  @map("payment_terms")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id          String              @id @default(uuid()) @db.Uuid
  number      String              @unique
  supplierId  String              @map("supplier_id") @db.Uuid
  warehouseId String              @map("warehouse_id") @db.Uuid
  status      PurchaseOrderStatus @default(DRAFT)
  expectedAt  DateTime?           @map("expected_at") @db.Timestamptz(6)
  notes       String?
  createdById String              @map("created_by_id") @db.Uuid
  approvedById String?            @map("approved_by_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedAt  DateTime?           @map("approved_at") @db.Timestamptz(6)
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines       PurchaseOrderLine[]
  receipts    PurchaseReceipt[]

  @@index([supplierId, status])
  @@index([warehouseId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                  String               @id @default(uuid()) @db.Uuid
  purchaseOrderId     String               @map("purchase_order_id") @db.Uuid
  productId           String               @map("product_id") @db.Uuid
  orderedQty          Int                  @map("ordered_qty")
  acceptedReceivedQty Int                  @default(0) @map("accepted_received_qty")
  unitCost            Decimal              @map("unit_cost") @db.Decimal(18, 2)
  purchaseOrder       PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product             Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptLines        PurchaseReceiptLine[]

  @@unique([purchaseOrderId, productId])
  @@map("purchase_order_lines")
}

model PurchaseReceipt {
  id              String          @id @default(uuid()) @db.Uuid
  number          String          @unique
  purchaseOrderId String          @map("purchase_order_id") @db.Uuid
  supplierReference String?       @map("supplier_reference")
  status          ReceiptStatus   @default(POSTED)
  receivedById    String          @map("received_by_id") @db.Uuid
  receivedAt      DateTime        @default(now()) @map("received_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  purchaseOrder   PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  lines           PurchaseReceiptLine[]

  @@index([purchaseOrderId, receivedAt])
  @@map("purchase_receipts")
}

model PurchaseReceiptLine {
  id                    String           @id @default(uuid()) @db.Uuid
  purchaseReceiptId     String           @map("purchase_receipt_id") @db.Uuid
  purchaseOrderLineId   String           @map("purchase_order_line_id") @db.Uuid
  productId             String           @map("product_id") @db.Uuid
  acceptedQty           Int              @default(0) @map("accepted_qty")
  rejectedQty           Int              @default(0) @map("rejected_qty")
  reason                String?
  purchaseReceipt       PurchaseReceipt  @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine     PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  product               Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([purchaseReceiptId, purchaseOrderLineId])
  @@map("purchase_receipt_lines")
}

model Customer {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  contactName   String?  @map("contact_name")
  email         String?
  phone         String?
  address       String?
  paymentTerms  String?  @map("payment_terms")
  creditLimit   Decimal? @map("credit_limit") @db.Decimal(18, 2)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  salesOrders   SalesOrder[]

  @@map("customers")
}

model SalesOrder {
  id          String           @id @default(uuid()) @db.Uuid
  number      String           @unique
  customerId  String           @map("customer_id") @db.Uuid
  warehouseId String           @map("warehouse_id") @db.Uuid
  status      SalesOrderStatus @default(DRAFT)
  deliveryAddress String?      @map("delivery_address")
  requestedAt DateTime?        @map("requested_at") @db.Timestamptz(6)
  notes       String?
  createdById String           @map("created_by_id") @db.Uuid
  confirmedAt DateTime?        @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt DateTime?        @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?   @map("cancellation_reason")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines       SalesOrderLine[]
  shipments   Shipment[]

  @@index([customerId, status])
  @@index([warehouseId, status])
  @@map("sales_orders")
}

model SalesOrderLine {
  id            String       @id @default(uuid()) @db.Uuid
  salesOrderId  String       @map("sales_order_id") @db.Uuid
  productId     String       @map("product_id") @db.Uuid
  orderedQty    Int          @map("ordered_qty")
  fulfilledQty  Int          @default(0) @map("fulfilled_qty")
  cancelledQty  Int          @default(0) @map("cancelled_qty")
  unitPrice     Decimal      @map("unit_price") @db.Decimal(18, 2)
  salesOrder    SalesOrder   @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product       Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  shipmentLines ShipmentLine[]

  @@unique([salesOrderId, productId])
  @@map("sales_order_lines")
}

model Shipment {
  id           String         @id @default(uuid()) @db.Uuid
  number       String         @unique
  salesOrderId String         @map("sales_order_id") @db.Uuid
  warehouseId  String         @map("warehouse_id") @db.Uuid
  status       ShipmentStatus @default(DISPATCHED)
  dispatchedAt DateTime       @default(now()) @map("dispatched_at") @db.Timestamptz(6)
  deliveredAt  DateTime?      @map("delivered_at") @db.Timestamptz(6)
  proofReference String?      @map("proof_reference")
  exceptionNote String?       @map("exception_note")
  createdById  String         @map("created_by_id") @db.Uuid
  salesOrder   SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines        ShipmentLine[]

  @@index([salesOrderId, status])
  @@map("shipments")
}

model ShipmentLine {
  id               String         @id @default(uuid()) @db.Uuid
  shipmentId       String         @map("shipment_id") @db.Uuid
  salesOrderLineId String         @map("sales_order_line_id") @db.Uuid
  productId        String         @map("product_id") @db.Uuid
  quantity         Int
  shipment         Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  salesOrderLine   SalesOrderLine @relation(fields: [salesOrderLineId], references: [id], onDelete: Restrict)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, salesOrderLineId])
  @@map("shipment_lines")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  requestId  String?  @map("request_id")
  reason     String?
  before     Json?
  after      Json?
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, occurredAt])
  @@map("audit_events")
}

